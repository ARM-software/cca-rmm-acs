+
+/* cppcheck-suppress misra-c2012-8.7 */
+void smc_dpt_l0_destroy(struct smc_result *res)
+{
+	unsigned long ret = dpt_feature_check();
+
+	if (ret != RMI_SUCCESS) {
+		res->x[0] = ret;
+		return;
+	}
+
+	if (!dpt_l0_created) {
+		res->x[0] = RMI_ERROR_INPUT;
+		return;
+	}
