+void smc_dpt_l1_create(unsigned long addr, struct smc_result *res)
+{
+	unsigned long ret = dpt_feature_check();
+
+	if (ret != RMI_SUCCESS) {
+		res->x[0] = ret;
+		return;
+	}
+
+	if (!dpt_l0_created) {
+		res->x[0] = RMI_ERROR_GLOBAL;
+		return;
+	}
+
+	if ((addr >= DPT_ADDR_BOUND) ||
+	    ((addr & (DPT_L1_ADDR_ALIGN - 1UL)) != 0UL)) {
+		res->x[0] = RMI_ERROR_INPUT;
+		return;
+	}
+
+	if (dpt_l1_created && (dpt_l1_addr == addr)) {
+		res->x[0] = RMI_ERROR_INPUT;
+		return;
+	}
+
+	dpt_l1_created = true;
+	dpt_l1_addr = addr;
+	res->x[0] = RMI_SUCCESS;
+}
+
+/* cppcheck-suppress misra-c2012-8.7 */
+void smc_dpt_l1_destroy(unsigned long addr, struct smc_result *res)
+{
+	unsigned long ret = dpt_feature_check();
+
+	if (ret != RMI_SUCCESS) {
+		res->x[0] = ret;
+		return;
+	}
+
+	if (!dpt_l0_created) {
+		res->x[0] = RMI_ERROR_GLOBAL;
+		return;
+	}
+
+	if ((addr >= DPT_ADDR_BOUND) ||
+	    ((addr & (DPT_L1_ADDR_ALIGN - 1UL)) != 0UL)) {
+		res->x[0] = RMI_ERROR_INPUT;
+		return;
+	}
+
+	if (!dpt_l1_created || (dpt_l1_addr != addr)) {
+		res->x[0] = RMI_ERROR_INPUT;
+		return;
+	}
